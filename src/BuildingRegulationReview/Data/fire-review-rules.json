{
  "schemaVersion": "1.0",
  "ruleSetId": "tw-bcr-fire",
  "version": "2026.6-provisional",
  "title": "建築技術規則建築設計施工編 防火構造與防火區劃（暫定示意規則：條文、版本與生效日期待 spec 19 第 2 項確認）。第70條主要構造規則列於優先序 20、第79條防火區劃規則列於優先序 10：兩者重疊的樓地板與承重牆壁，第70條的要求恆不低於第79條，故由第70條決定；非承重的區劃牆壁不屬第70條的主要構造，落回第79條。CompartmentArea 同樣分兩層：`tw-bcr-83-area` 是十一層以上部分的區劃面積規則，列於優先序 20，其上限（即使備有自動滅火設備而加倍，最寬也只到一○○○平方公尺）恆嚴於優先序 10 的 `tw-bcr-79-area`，故十一層以上由前者決定，十層以下前者的適用條件不成立而落回後者。兩條面積規則的豁免清單一致，都是第79條之2第1項的垂直區劃（挑空、昇降階梯間、樓梯間、昇降機道、管道間）：那些空間由第79條之2 單獨區劃，不因所在樓層而改由另一條面積規則管；「其他類似部分」無法逐一列舉，清單外的用字一律不豁免。CompartmentContinuity 規則檢討防火區劃與帷幕外牆的交接，依條文結構把「應突出五十公分」寫成要求值、把「得免突出」的九十公分但書寫成豁免條件，詳見 docs/regulations/curtain-wall-fire-compartment.md。VerticalCompartment 規則接手上述豁免的垂直區劃，但只寫第79條之2第1項本文之外的附加要求——昇降機道防火設備的遮煙性能、管道間維修門的一小時防火時效與遮煙性能；本文的一小時區劃牆壁與防火設備不分區劃來源，仍由 tw-bcr-79-wall-rating 與 tw-bcr-79-opening 檢討，不在此重複，詳見 docs/regulations/vertical-compartment.md。",
  "rules": [
    {
      "ruleId": "tw-bcr-79-area",
      "version": "2",
      "category": "CompartmentArea",
      "legalReference": "建築技術規則建築設計施工編第79條第1項（暫定）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true",
      "requiredValue": "zone.area <= (zone.sprinklered ? 3000 m2 : 1500 m2)",
      "exemptions": [
        "zone.use == \"挑空\"",
        "zone.use == \"昇降階梯間\"",
        "zone.use == \"樓梯間\"",
        "zone.use == \"昇降機道\"",
        "zone.use == \"管道間\""
      ],
      "evidenceFields": [ "zone.area", "zone.sprinklered", "zone.use", "building.fireResistiveConstruction" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-83-area",
      "version": "2",
      "category": "CompartmentArea",
      "legalReference": "建築技術規則建築設計施工編第83條第1款至第4款（十一層以上部分之區劃面積，暫定）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 20,
      "appliesWhen": "building.fireResistiveConstruction == true && zone.floorNumber >= 11",
      "requiredValue": "zone.area <= (zone.sprinklered ? 2 : 1) * (zone.interiorFinish == \"耐燃一級含底材\" ? 500 m2 : (zone.interiorFinish == \"耐燃一級\" ? (building.use == \"H-2\" ? 400 m2 : 200 m2) : (building.use == \"H-2\" ? 200 m2 : 100 m2)))",
      "exemptions": [
        "zone.use == \"挑空\"",
        "zone.use == \"昇降階梯間\"",
        "zone.use == \"樓梯間\"",
        "zone.use == \"昇降機道\"",
        "zone.use == \"管道間\""
      ],
      "evidenceFields": [ "zone.area", "zone.floorNumber", "zone.interiorFinish", "zone.sprinklered", "zone.use", "building.use", "building.fireResistiveConstruction" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-70-column-rating",
      "version": "2",
      "category": "FireResistance",
      "legalReference": "建築技術規則建築設計施工編第70條（主要構造之柱，依自頂層起算之層位）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 20,
      "appliesWhen": "building.fireResistiveConstruction == true && element.category == \"Columns\" && element.isStructural == true",
      "requiredValue": "element.providedFireRating >= ((zone.floorNumber > 0 ? building.floorsAboveGround - zone.floorNumber + 1 : building.floorsAboveGround - zone.floorNumber) >= 15 ? 180 min : ((zone.floorNumber > 0 ? building.floorsAboveGround - zone.floorNumber + 1 : building.floorsAboveGround - zone.floorNumber) >= 5 ? 120 min : 60 min))",
      "exemptions": [],
      "evidenceFields": [ "element.typeName", "element.providedFireRating", "zone.floorNumber", "building.floorsAboveGround" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-70-beam-rating",
      "version": "1",
      "category": "FireResistance",
      "legalReference": "建築技術規則建築設計施工編第70條（主要構造之樑，依自頂層起算之層位）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 20,
      "appliesWhen": "building.fireResistiveConstruction == true && element.category == \"StructuralFraming\" && element.isStructural == true",
      "requiredValue": "element.providedFireRating >= ((zone.floorNumber > 0 ? building.floorsAboveGround - zone.floorNumber + 1 : building.floorsAboveGround - zone.floorNumber) >= 15 ? 180 min : ((zone.floorNumber > 0 ? building.floorsAboveGround - zone.floorNumber + 1 : building.floorsAboveGround - zone.floorNumber) >= 5 ? 120 min : 60 min))",
      "exemptions": [],
      "evidenceFields": [ "element.typeName", "element.providedFireRating", "zone.floorNumber", "building.floorsAboveGround" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-70-bearing-wall-rating",
      "version": "1",
      "category": "FireResistance",
      "legalReference": "建築技術規則建築設計施工編第70條（主要構造之承重牆壁，依自頂層起算之層位）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 20,
      "appliesWhen": "building.fireResistiveConstruction == true && element.category == \"Walls\" && element.isStructural == true",
      "requiredValue": "element.providedFireRating >= ((zone.floorNumber > 0 ? building.floorsAboveGround - zone.floorNumber + 1 : building.floorsAboveGround - zone.floorNumber) >= 15 ? 120 min : 60 min)",
      "exemptions": [],
      "evidenceFields": [ "element.typeName", "element.providedFireRating", "element.isCompartmentBoundary", "zone.floorNumber", "building.floorsAboveGround" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-70-floor-rating",
      "version": "1",
      "category": "FireResistance",
      "legalReference": "建築技術規則建築設計施工編第70條（主要構造之樓地板，依自頂層起算之層位）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 20,
      "appliesWhen": "building.fireResistiveConstruction == true && element.category == \"Floors\"",
      "requiredValue": "element.providedFireRating >= ((zone.floorNumber > 0 ? building.floorsAboveGround - zone.floorNumber + 1 : building.floorsAboveGround - zone.floorNumber) >= 5 ? 120 min : 60 min)",
      "exemptions": [],
      "evidenceFields": [ "element.typeName", "element.providedFireRating", "zone.floorNumber", "building.floorsAboveGround" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-wall-rating",
      "version": "2",
      "category": "FireResistance",
      "legalReference": "建築技術規則建築設計施工編第79條第1項（暫定：區劃牆壁一小時以上防火時效）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && element.category == \"Walls\" && element.isCompartmentBoundary == true && element.isCurtainWall != true",
      "requiredValue": "element.providedFireRating >= 60 min",
      "exemptions": [],
      "evidenceFields": [ "element.typeName", "element.providedFireRating" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-floor-rating",
      "version": "1",
      "category": "FireResistance",
      "legalReference": "建築技術規則建築設計施工編第79條第1項（暫定：區劃樓地板一小時以上防火時效）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && element.category == \"Floors\"",
      "requiredValue": "element.providedFireRating >= 60 min",
      "exemptions": [],
      "evidenceFields": [ "element.typeName", "element.providedFireRating" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-opening",
      "version": "1",
      "category": "OpeningProtection",
      "legalReference": "建築技術規則建築設計施工編第79條第1項（暫定：區劃牆壁上之開口應設防火門窗）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && opening.hostIsCompartmentBoundary == true",
      "requiredValue": "opening.providedFireProtection == \"是\"",
      "exemptions": [],
      "evidenceFields": [ "opening.kind", "opening.hostUniqueId", "opening.providedFireProtection" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-curtain-wall-junction",
      "version": "1",
      "category": "CompartmentContinuity",
      "legalReference": "建築技術規則建築設計施工編第79條第3項、第4項（區劃來源含第83條）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && junction.kind == \"WallToCurtainWall\"",
      "requiredValue": "junction.projectionDepth >= 500 mm",
      "exemptions": [
        "junction.continuousFireRatedLength >= 900 mm"
      ],
      "evidenceFields": [ "junction.curtainWallUniqueId", "junction.hostUniqueId", "junction.hostLegalReference", "junction.continuousFireRatedLength", "junction.minFireRating", "junction.hostRequiredFireRating", "junction.hasUnprotectedOpening" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-3-curtain-wall-spandrel",
      "version": "1",
      "category": "CompartmentContinuity",
      "legalReference": "建築技術規則建築設計施工編第79條之3",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && junction.kind == \"FloorToCurtainWall\"",
      "requiredValue": "junction.projectionDepth >= 500 mm",
      "exemptions": [
        "junction.continuousFireRatedHeight >= 900 mm"
      ],
      "evidenceFields": [ "junction.curtainWallUniqueId", "junction.hostUniqueId", "junction.continuousFireRatedHeight", "junction.minFireRating", "junction.hostRequiredFireRating" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-4-curtain-wall-other",
      "version": "1",
      "category": "CompartmentContinuity",
      "legalReference": "建築技術規則建築設計施工編第79條之4",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 20,
      "appliesWhen": "building.fireResistiveConstruction == true && junction.kind == \"CurtainPanelOther\"",
      "requiredValue": "junction.minFireRating >= 30 min",
      "exemptions": [],
      "evidenceFields": [ "junction.curtainWallUniqueId", "junction.zoneId" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-2-hoistway-smoke-seal",
      "version": "1",
      "category": "VerticalCompartment",
      "legalReference": "建築技術規則建築設計施工編第79條之2第1項（昇降機道裝設之防火設備應具有遮煙性能）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && shaft.requirement == \"HoistwaySmokeSeal\"",
      "requiredValue": "shaft.providedSmokeProtection == \"是\"",
      "exemptions": [
        "shaft.elevatorLobbyProtected == true"
      ],
      "evidenceFields": [ "zone.id", "zone.use", "shaft.elementUniqueId", "shaft.elevatorLobbyProtected", "building.fireResistiveConstruction" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-2-shaft-door-rating",
      "version": "1",
      "category": "VerticalCompartment",
      "legalReference": "建築技術規則建築設計施工編第79條之2第1項（管道間之維修門應具有一小時以上防火時效）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && shaft.requirement == \"ShaftDoorRating\"",
      "requiredValue": "shaft.providedFireRating >= 60 min",
      "exemptions": [],
      "evidenceFields": [ "zone.id", "zone.use", "shaft.elementUniqueId", "building.fireResistiveConstruction" ],
      "severity": "Error"
    },
    {
      "ruleId": "tw-bcr-79-2-shaft-door-smoke-seal",
      "version": "1",
      "category": "VerticalCompartment",
      "legalReference": "建築技術規則建築設計施工編第79條之2第1項（管道間之維修門應具有遮煙性能）",
      "effectiveDate": "2024-01-01",
      "jurisdiction": "TW",
      "priority": 10,
      "appliesWhen": "building.fireResistiveConstruction == true && shaft.requirement == \"ShaftDoorSmokeSeal\"",
      "requiredValue": "shaft.providedSmokeProtection == \"是\"",
      "exemptions": [],
      "evidenceFields": [ "zone.id", "zone.use", "shaft.elementUniqueId", "building.fireResistiveConstruction" ],
      "severity": "Error"
    }
  ]
}
