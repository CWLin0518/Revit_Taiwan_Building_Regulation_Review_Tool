<Window x:Class="BuildingRegulationReview.FireReview.FireReviewParameterSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="防火檢討參數一鍵建立" Width="1120" Height="700" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#62666A" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="112" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="防火檢討參數一鍵建立" FontSize="20" FontWeight="SemiBold" Foreground="#202124" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"
                       Text="把防火區劃檢討要讀的共用參數一次加進目前的專案並綁好類別。定義來自外掛自己的共用參數檔，GUID 固定，所以換模型、換電腦都對得起來。已經綁好的不會被動到；同名但 GUID、資料型別或實體／類型不符的一律不覆蓋，只列出修正方式讓你自己決定。" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#FFF4E5"
                BorderBrush="#F0C48A" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="建立之後還要填值" FontWeight="SemiBold" Foreground="#8A5200" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18" Foreground="#6B4A12"
                           Text="這個功能只建立參數，不填任何值。專案資訊的「防火構造建築物」要勾起來，否則整套規則都不啟動；區劃的滅火設備與用途填在 Area 上；構件與門窗的時效、結構材料、防火門窗與遮煙性能可以用「防火參數批次設定」面板批次填。建立參數會改動專案，建議先存檔備份。" />
            </StackPanel>
        </Border>

        <Border x:Name="ConflictBox" Grid.Row="2" Margin="0,10,0,0" Padding="10" Visibility="Collapsed"
                Background="#FDECEA" BorderBrush="#F3B5AE" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="ConflictText" TextWrapping="Wrap" LineHeight="18" Foreground="#8A2C22" />
        </Border>

        <DataGrid x:Name="Rows" Grid.Row="3" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="White"
                  BorderBrush="#D5D8DC" BorderThickness="1" VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                            <Setter Property="Background" Value="#FDECEA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWork}" Value="True">
                            <Setter Property="Background" Value="#EAF4EC" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="狀態" Binding="{Binding StatusText}" Width="120" />
                <DataGridTextColumn Header="參數名稱" Binding="{Binding Name}" Width="190" />
                <DataGridTextColumn Header="型別" Binding="{Binding ValueTypeText}" Width="60" />
                <DataGridTextColumn Header="層級" Binding="{Binding LevelText}" Width="80" />
                <DataGridTextColumn Header="綁定類別" Binding="{Binding HostsText}" Width="190" />
                <DataGridTemplateColumn Header="說明／修正方式" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="4,3" LineHeight="17" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusLine" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#202124" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CreateButton" Content="建立並綁定" IsDefault="True" Click="OnCreate" />
            <Button x:Name="RefreshButton" Content="重新檢查" Click="OnRefresh" />
            <Button Content="關閉" IsCancel="True" Click="OnClose" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
