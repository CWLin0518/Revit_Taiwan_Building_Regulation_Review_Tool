<UserControl x:Class="BuildingRegulationReview.ReviewPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300" Background="#F5F6F7">
    <!-- 檢討面板：所有檢討工具的唯一人工入口。工具清單與說明來自 Data/review-items.json，
         動作按鈕來自各工具的 IReviewFeature；新增工具不改這份 XAML（DESIGN.md §2）。 -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="建築技術規則檢討" FontSize="20" FontWeight="SemiBold" Foreground="#202124" />
            <TextBlock Margin="0,4,0,8" Text="選擇檢討工具，依序執行下方的步驟" Foreground="#62666A" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D5D8DC" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBox x:Name="SearchBox" Margin="10,8" BorderThickness="0"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_OnTextChanged" />
                <TextBlock x:Name="SearchHint" Margin="12,8" Text="搜尋工具、法條或關鍵字…"
                           Foreground="#8A8F94" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,6">
            <TextBlock Text="檢討工具" FontWeight="SemiBold" />
            <TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="#62666A" />
        </Grid>

        <ListBox x:Name="ReviewItemsList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                 SelectionChanged="ReviewItemsList_OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,7" Padding="10" Background="White" BorderBrush="#DDE0E3"
                            BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#246BCE" />
                            <TextBlock Margin="0,3,0,2" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LegalReference}" Foreground="#62666A" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Separator Grid.Row="4" Margin="0,10" />

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailReference" Margin="0,5,0,10" Foreground="#246BCE" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" LineHeight="20" />
                <StackPanel x:Name="StepsSection">
                    <TextBlock Margin="0,12,0,3" Text="操作步驟" FontWeight="SemiBold" />
                    <Border Padding="10" Background="#EAF2FF" BorderBrush="#B8D1F5" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="DetailSteps" TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,12,0,3" Text="預計產出" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailOutput" Foreground="#62666A" TextWrapping="Wrap" />
                <StackPanel Margin="0,14,0,0">
                    <TextBlock x:Name="ActionsHeader" Margin="0,0,0,6" Text="動作" FontWeight="SemiBold" Visibility="Collapsed" />
                    <TextBlock x:Name="NoActionText" Foreground="#62666A" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="這個項目尚未提供可執行的動作。" />
                    <ItemsControl x:Name="ActionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Padding="12,8" HorizontalContentAlignment="Left"
                                        Tag="{Binding ActionId}" ToolTip="{Binding Description}" Click="ActionButton_OnClick">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
