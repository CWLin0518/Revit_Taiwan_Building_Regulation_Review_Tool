<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AI 代理以 stdio 啟動的 MCP bridge：代理設定只寫這個 exe 的路徑，bridge 每次請求都從
    %LOCALAPPDATA%\BuildingRegulationReview\Mcp\endpoint.json 找 Revit 外掛的端點與權杖，
    所以 Revit 重開、權杖換新都不必改代理設定（docs/mcp-server.md §3）。
    net48：Windows 內建，免裝 .NET runtime；邏輯都在 BuildingRegulationReview.Mcp，由 Core.Tests 測。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>BuildingRegulationReview.McpBridge</AssemblyName>
    <RootNamespace>BuildingRegulationReview.McpBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BuildingRegulationReview.Mcp\BuildingRegulationReview.Mcp.csproj" />
  </ItemGroup>
</Project>
